# Matikan directory listing agar isi folder proyek tidak terekspos
Options -Indexes

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses langsung ke file sensitif dan direktori internal
    RewriteRule ^(\.|AGENT\.md|PRD\.md|PRD-v2\.md|README\.md|.*\.(docx|sql|zip)|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|artisan) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|lang|laporan|resources|routes|tests|vendor)(/|$) - [F,L,NC]
    RewriteRule ^storage/?$ - [F,L,NC]
    RewriteRule ^storage/(app|framework|logs)(/|$) - [F,L,NC]

    # Arahkan seluruh request secara internal ke direktori public/
    RewriteCond %{REQUEST_URI} !^/Ruang_Temu_Buku_v2/public/ [NC]
    RewriteRule ^(?!public/)(.*)$ public/$1 [L,QSA,NC]
</IfModule>
